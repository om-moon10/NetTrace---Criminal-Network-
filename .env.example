# Turso Cloud Database (Production & Vercel deployment)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gemini AI integration key (configured in AI Studio Settings -> Secrets or locally in .env)
GEMINI_API_KEY=

# Threat intelligence API endpoint (optional)
THREATVIEW_API_URL=https://threat-view-port.vercel.app/

# Client-side API URL override (optional, defaults to relative /api when running with Vite proxy)
VITE_API_URL=


